{
  "name": "comparabledata-web",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "typecheck": "vue-tsc --build --force",
    "lint": "eslint . --cache",
    "lint:fix": "eslint . --cache --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "api:generate": "node scripts/generate-api.mjs",
    "api:check": "node scripts/check-generated-api.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "build": "vite build",
    "build:budget": "node scripts/check-bundle-budget.mjs",
    "check": "npm run format:check && npm run typecheck && npm run lint && npm run test && npm run build && npm run build:budget",
    "preview": "vite preview",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@fontsource-variable/instrument-sans": "^5.3.0",
    "@primeuix/themes": "^2.0.3",
    "@tanstack/vue-query": "^5.102.5",
    "openapi-fetch": "^0.17.0",
    "pinia": "^4.0.2",
    "primeicons": "^7.0.0",
    "primevue": "^4.5.5",
    "vue": "^3.5.40",
    "vue-router": "^5.2.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.61.1",
    "@tailwindcss/vite": "^4.3.3",
    "@tsconfig/node24": "^24.0.5",
    "@types/node": "^24.13.3",
    "@vitejs/plugin-vue": "^6.0.8",
    "@vue/test-utils": "^2.4.11",
    "@vue/tsconfig": "^0.8.1",
    "axe-core": "^4.13.0",
    "eslint": "^10.9.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-simple-import-sort": "^14.0.0",
    "eslint-plugin-vue": "^10.10.0",
    "globals": "^16.5.0",
    "jsdom": "^30.0.1",
    "msw": "^2.15.0",
    "openapi-typescript": "^7.13.0",
    "prettier": "^3.9.6",
    "tailwindcss": "^4.3.3",
    "typescript": "5.9",
    "typescript-eslint": "^8.68.0",
    "vite": "^8.1.5",
    "vite-plugin-vue-devtools": "^8.1.5",
    "vitest": "^4.1.11",
    "vue-tsc": "^3.3.11"
  },
  "engines": {
    "node": "^22.18.0 || >=24.12.0"
  },
  "allowScripts": {
    "vue-demi@0.14.10": true,
    "msw@2.15.0": true
  },
  "msw": {
    "workerDirectory": [
      "public"
    ]
  }
}
